---
const { title = 'ZtaMDev | Portafolio', description = 'Portafolio de Manuel Ricardo (ZtaMDev): proyectos, IA, automatización y desarrollo indie.' } = Astro.props;
import '../styles/global.css';
---
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <!-- Falling stars canvas (behind) -->
    <canvas id="stars-canvas" class="fixed inset-0 -z-20 pointer-events-none"></canvas>
    <!-- Decorative background orbs for subtle parallax -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div id="orb1" class="orb orb-1 w-[38rem] h-[38rem] -top-20 -left-20"></div>
      <div id="orb2" class="orb orb-2 w-[30rem] h-[30rem] top-40 -right-10"></div>
    </div>
    <div id="topbar" class="sticky top-0 z-50 bg-white/10 dark:bg-white/10 backdrop-blur-md border-b border-white/10 shadow-glass transition-transform duration-300">
      <div class="container-smooth">
        <header class="px-0 sm:px-0 py-3 flex items-center justify-between">
          <a href="#" class="flex items-center gap-3">
            <img src="/logo.png" alt="Logo" class="w-9 h-9" />
            <span class="font-semibold tracking-tight text-white/90">ZtaMDev</span>
          </a>
          <nav class="flex items-center gap-3">
            <a href="#proyectos" class="btn-ghost text-sm">Proyectos</a>
            <a href="#contacto" class="btn-primary text-sm">Contáctame</a>
          </nav>
        </header>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="container-smooth py-12 text-center text-sm text-slate-400">
      <div class="flex flex-col items-center gap-2">
        <div>© 2025 • Manuel Ricardo (ZtaMDev)</div>
        <div class="flex items-center gap-4">
          <a href="#proyectos" class="text-white/80 hover:text-white underline-offset-4 hover:underline">Proyectos</a>
        </div>
      </div>
    </footer>
  </body>
</html>
